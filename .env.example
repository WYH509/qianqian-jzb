# ===== DeepSeek API（v2 决策树：Flash 结构化解析 / Pro 多步推理 + OCR）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_RETRIES=2

# ===== Auth（单用户，PRD §3.1）=====
OWNER_PASSWORD=__SET_BEFORE_FIRST_LOGIN__

# ===== Server =====
PORT=3456
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1

# ===== Database（SQLite + 加密备份，PRD §13 + §16）=====
DB_PATH=./qianqian-jzb.db
DB_PASSPHRASE=__SET_AT_FIRST_DEPLOY__

# ===== Backup（PRD §17.6 / §16.x 7z 加密）=====
BACKUP_PASSPHRASE=__SET_AT_FIRST_DEPLOY__
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON="0 0 * * *"        # 每日 0 点

# ===== Tailscale Funnel（PRD §17.x 部署）=====
TAILSCALE_FUNNEL_ENABLED=false
TAILSCALE_FUNNEL_PORT=3456
TAILSCALE_FUNNEL_HOSTNAME=qianqian-jzb

# ===== AI Queue（PRD §9.8 / §9.9 高峰入队 / 闲时直调）=====
# 闲时段：00:00-09:00 / 12:00-14:00 / 18:00-24:00 + 周末全天
# 高峰期：09:00-12:00 / 14:00-18:00 入 ai_parse_queue
AI_QUEUE_ENABLED=true
AI_QUEUE_BATCH_SIZE=20
AI_QUEUE_CRON_1="0 0 * * 1-5"
AI_QUEUE_CRON_2="0 12 * * 1-5"
AI_QUEUE_CRON_3="0 18 * * 1-5"
AI_QUEUE_BACKLOG_ALERT=100

# ===== Feishu 通知（PRD §9.9.5 / §17.7 失败 / 完成通知）=====
FEISHU_WEBHOOK_URL=
FEISHU_USER_OPEN_ID=

# ===== 7z / 部署工具路径 =====
SEVENZ_BIN=/opt/homebrew/bin/7z
SQLITE3_BIN=/opt/homebrew/bin/sqlite3